# Copie este archivo como ".env" y cambie los valores.
# El archivo .env NUNCA se sube a GitHub (tiene contraseñas).

# --- Base de datos local (PostgreSQL en su computador) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pos_restaurante
DB_USER=postgres
DB_PASSWORD=su_contraseña

# --- Base de datos en la nube (opcional) ---
# Si existe DATABASE_URL se usa en lugar de las variables DB_*.
# DATABASE_URL=postgres://usuario:clave@servidor:5432/base
# DATABASE_SSL=true

# --- Servidor ---
PORT=3000
# development | production | test
NODE_ENV=development

# --- Seguridad ---
# Texto largo y aleatorio (mínimo 16 caracteres). Cada integrante puede
# poner el suyo. Ejemplo para generarlo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambie_esto_por_un_texto_largo_y_aleatorio
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7
MAX_SESSIONS_PER_USER=5

# Páginas que pueden llamar a la API (separadas por coma)
CORS_ORIGINS=http://localhost:5173

# Primer administrador (opcional). Si existen, el servidor lo crea al
# arrancar cuando todavía no existe. Útil en la nube sin terminal.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=una_clave_de_al_menos_8_caracteres
